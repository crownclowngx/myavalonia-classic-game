<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RichTownStrideVersion>4.3.0.2507</RichTownStrideVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="[12.1.0]" />
    <PackageVersion Include="Stride.Engine" Version="[$(RichTownStrideVersion)]" />
    <PackageVersion Include="Avalonia.Desktop" Version="[12.1.0]" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="[8.4.2]" />
    <PackageVersion Include="coverlet.collector" Version="[6.0.4]" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="[18.8.1]" />
    <PackageVersion Include="MyAvaloniaManagement.Plugin.Build" Version="[3.4.2-richtown.1]" />
    <PackageVersion Include="MyAvaloniaManagement.PluginSdk" Version="[3.4.0]" />
    <PackageVersion Include="MyAvaloniaManagement.PluginSdk.UI" Version="[3.4.0]" />
    <PackageVersion Include="xunit" Version="[2.9.3]" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="[3.1.5]" />
  </ItemGroup>
</Project>
