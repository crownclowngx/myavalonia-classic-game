<Window
    x:Class="ClassicGamePlugin.Standalone.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mines="using:ClassicGamePlugin.Features.Minesweeper.Views"
    xmlns:spider="using:ClassicGamePlugin.Features.SpiderSolitaire.Views"
    xmlns:reversi="using:ClassicGamePlugin.Features.Reversi.Views"
    xmlns:gomoku="using:ClassicGamePlugin.Features.Gomoku.Views"
    xmlns:xiangqi="using:ClassicGamePlugin.Features.Xiangqi.Views"
    Width="1080"
    Height="760"
    Title="ClassicGamePlugin Standalone">
  <TabControl>
    <TabItem Header="扫雷">
      <mines:MinesweeperDocumentView x:Name="MinesweeperHost" />
    </TabItem>
    <TabItem Header="蜘蛛纸牌">
      <spider:SpiderSolitaireDocumentView x:Name="SpiderSolitaireHost" />
    </TabItem>
    <TabItem Header="黑白棋">
      <reversi:ReversiDocumentView x:Name="ReversiHost" />
    </TabItem>
    <TabItem Header="五子棋">
      <gomoku:GomokuDocumentView x:Name="GomokuHost" />
    </TabItem>
    <TabItem Header="中国象棋">
      <xiangqi:XiangqiDocumentView x:Name="XiangqiHost" />
    </TabItem>
  </TabControl>
</Window>
