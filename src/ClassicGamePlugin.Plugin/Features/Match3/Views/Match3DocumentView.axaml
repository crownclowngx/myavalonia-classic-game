<UserControl
    x:Class="ClassicGamePlugin.Features.Match3.Views.Match3DocumentView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:feature="using:ClassicGamePlugin.Features.Match3"
    xmlns:vm="using:ClassicGamePlugin.Features.Match3.ViewModels"
    xmlns:views="using:ClassicGamePlugin.Features.Match3.Views"
    x:DataType="feature:Match3Document">
  <ContentControl x:Name="ViewModelHost" Content="{Binding ViewModel}">
    <ContentControl.ContentTemplate>
      <DataTemplate x:DataType="vm:Match3ViewModel">
        <views:Match3View />
      </DataTemplate>
    </ContentControl.ContentTemplate>
  </ContentControl>
</UserControl>
