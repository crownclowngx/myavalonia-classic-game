<UserControl
    x:Class="ClassicGamePlugin.Features.FreeCell.Views.FreeCellView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ClassicGamePlugin.Features.FreeCell.ViewModels"
    xmlns:views="using:ClassicGamePlugin.Features.FreeCell.Views"
    x:DataType="vm:FreeCellViewModel">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="FreeCellPanelBrush" Color="#FFF4F6F8" />
          <SolidColorBrush x:Key="FreeCellBorderBrush" Color="#FFA8B1BD" />
          <SolidColorBrush x:Key="FreeCellTextBrush" Color="#FF253142" />
          <SolidColorBrush x:Key="FreeCellMutedBrush" Color="#FF667085" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="FreeCellPanelBrush" Color="#FF252B33" />
          <SolidColorBrush x:Key="FreeCellBorderBrush" Color="#FF596574" />
          <SolidColorBrush x:Key="FreeCellTextBrush" Color="#FFF4F7FB" />
          <SolidColorBrush x:Key="FreeCellMutedBrush" Color="#FFB7C0CC" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid Margin="20" RowDefinitions="Auto,*" RowSpacing="14">
    <Border
        Padding="12"
        Background="{DynamicResource FreeCellPanelBrush}"
        BorderBrush="{DynamicResource FreeCellBorderBrush}"
        BorderThickness="1"
        CornerRadius="6">
      <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Margin="0,0,8,6" Foreground="{DynamicResource FreeCellTextBrush}" Text="牌局编号" VerticalAlignment="Center" />
        <TextBox
            x:Name="DealNumberInput"
            Width="130"
            Margin="0,0,8,6"
            IsEnabled="{Binding CanInteract}"
            KeyDown="OnDealNumberKeyDown"
            Text="{Binding DealNumberText}" />
        <Button Margin="0,0,8,6" Command="{Binding LoadDealCommand}" Content="加载编号" />
        <Button Margin="0,0,8,6" Command="{Binding NewRandomDealCommand}" Content="随机新局" />
        <Button Margin="0,0,8,6" Command="{Binding ReplaySameDealCommand}" Content="同局重开" />
        <Button Margin="0,0,8,6" Command="{Binding CancelGenerationCommand}" Content="取消生成" IsVisible="{Binding IsGenerating}" />
        <Button Margin="0,0,8,6" Command="{Binding UndoCommand}" Content="撤销" ToolTip.Tip="Ctrl+Z" />
        <Button Margin="0,0,12,6" Command="{Binding HintCommand}" Content="求解提示" ToolTip.Tip="H" />
        <CheckBox Margin="0,0,12,6" Content="安全自动收牌" IsChecked="{Binding IsAutoCollectEnabled}" />
        <CheckBox Margin="0,0,14,6" Content="动画" IsChecked="{Binding AreAnimationsEnabled}" />
        <TextBlock Margin="0,0,12,6" Foreground="{DynamicResource FreeCellTextBrush}" FontWeight="SemiBold" Text="{Binding StatusText}" />
        <TextBlock Margin="0,0,12,6" Foreground="{DynamicResource FreeCellTextBrush}" Text="{Binding MoveCount, StringFormat={}步数 {0}}" />
        <TextBlock Margin="0,0,12,6" Foreground="{DynamicResource FreeCellTextBrush}" Text="{Binding FoundationCardCount, StringFormat={}基础区 {0}/52}" />
        <TextBlock Margin="0,0,0,6" Foreground="{DynamicResource FreeCellTextBrush}" Text="{Binding ElapsedSeconds, StringFormat={}用时 {0} 秒}" />
      </WrapPanel>
    </Border>

    <Grid Grid.Row="1">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <views:FreeCellBoardControl
            HorizontalAlignment="Center"
            Game="{Binding}"
            Width="912"
            Height="{Binding BoardHeight}" />
      </ScrollViewer>

      <Border
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Padding="30,22"
          Background="{DynamicResource FreeCellPanelBrush}"
          BorderBrush="{DynamicResource FreeCellBorderBrush}"
          BorderThickness="2"
          CornerRadius="12"
          IsVisible="{Binding IsWon}">
        <StackPanel Spacing="8">
          <TextBlock HorizontalAlignment="Center" FontSize="27" FontWeight="Bold" Foreground="{DynamicResource FreeCellTextBrush}" Text="恭喜获胜" />
          <TextBlock Foreground="{DynamicResource FreeCellMutedBrush}" Text="四种花色已全部收至基础区" />
        </StackPanel>
      </Border>

      <Border
          HorizontalAlignment="Center"
          VerticalAlignment="Bottom"
          Margin="12"
          Padding="10,6"
          Background="{DynamicResource FreeCellPanelBrush}"
          BorderBrush="{DynamicResource FreeCellBorderBrush}"
          BorderThickness="1"
          CornerRadius="5"
          IsHitTestVisible="False">
        <TextBlock Foreground="{DynamicResource FreeCellMutedBrush}" Text="{Binding MessageText}" TextWrapping="Wrap" />
      </Border>
    </Grid>
  </Grid>
</UserControl>
