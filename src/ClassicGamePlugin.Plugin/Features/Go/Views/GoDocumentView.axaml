<UserControl
    x:Class="ClassicGamePlugin.Features.Go.Views.GoDocumentView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:feature="using:ClassicGamePlugin.Features.Go"
    xmlns:vm="using:ClassicGamePlugin.Features.Go.ViewModels"
    xmlns:views="using:ClassicGamePlugin.Features.Go.Views"
    x:DataType="feature:GoDocument">
  <ContentControl x:Name="ViewModelHost" Content="{Binding ViewModel}">
    <ContentControl.ContentTemplate>
      <DataTemplate x:DataType="vm:GoViewModel"><views:GoView /></DataTemplate>
    </ContentControl.ContentTemplate>
  </ContentControl>
</UserControl>
