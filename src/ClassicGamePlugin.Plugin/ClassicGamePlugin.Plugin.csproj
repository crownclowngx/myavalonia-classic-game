<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ManagedPlugin>true</ManagedPlugin>
    <ManagedPluginId>myavalonia.plugin.classic.game</ManagedPluginId>
    <ManagedPluginDirectoryName>ClassicGamePlugin</ManagedPluginDirectoryName>
    <PluginVersion>1.2.0</PluginVersion>
    <ManagedPluginRuntimeIdentifier>win-x64</ManagedPluginRuntimeIdentifier>
    <ManagedPluginEntryType>ClassicGamePlugin.Plugin.ClassicGamePluginModule</ManagedPluginEntryType>
    <ManagedPluginSdkMinInclusive>3.4.0</ManagedPluginSdkMinInclusive>
    <ManagedPluginSdkMaxExclusive>4.0.0</ManagedPluginSdkMaxExclusive>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="MyAvaloniaManagement.Plugin.Build" PrivateAssets="all" />
    <PackageReference Include="MyAvaloniaManagement.PluginSdk" />
    <PackageReference Include="MyAvaloniaManagement.PluginSdk.UI" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClassicGamePlugin.Tests" />
    <InternalsVisibleTo Include="ClassicGamePlugin.RichTown.Tests" />
    <!-- 开发窗口的显式 G3 检查复用内部会话，不对外扩展 SDK，也不复制玩法规则。 -->
    <InternalsVisibleTo Include="ClassicGamePlugin.Standalone" />
    <ProjectReference Include="..\ClassicGamePlugin.RichTown.Stride\ClassicGamePlugin.RichTown.Stride.csproj" />
  </ItemGroup>

  <Import Project="Features/RichTown/RichTown.Deployment.targets" />
</Project>
