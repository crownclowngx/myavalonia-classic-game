<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="rich-town-build" value="build/feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!-- 精确来源映射只影响构建工具；SDK、引擎及全部业务依赖继续使用公开源。 -->
    <packageSource key="rich-town-build">
      <package pattern="MyAvaloniaManagement.Plugin.Build" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
